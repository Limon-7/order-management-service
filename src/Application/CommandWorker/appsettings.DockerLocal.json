{
  "ServiceId": "order-management",
  "ServiceName": "Order Management Service",
  "ServiceRegistrationsFilePath": "/app/Settings/ServiceRegistrations/ServiceRegistrations.json",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "BusConfig": {
    "ConnectionString": "amqp://guest:guest@host.docker.internal:5672/",
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "Bits.OrderManagement.Application.Commands",
    "PrefetchCount": 20,
    "RetryCount": 3,
    "RetryInterval": 5
  },
  "MongoDb": {
    "ConnectionString": "mongodb://host.docker.internal:27017",
    "DatabaseName": "order-management_db"
  }
  // Optional: uncomment if Redis is used (redis = container name in compose network)
  // "ConnectionStrings": {
  //   "Redis": "redis:6379"
  // }
}
