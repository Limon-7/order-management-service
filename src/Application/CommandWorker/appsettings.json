{
  "AllowedHosts": "*",
  "ServiceId": "order-management",
  "ServiceName": "Order Management Service",
  "DefaultLogLevel": "info",
  "ServiceRegistrationsFilePath": "",
  "BusConfig": {
    "ConnectionString": "amqp://guest:guest@localhost:5672/",
    "UserName": "guest",
    "Password": "guest",
    "QueueName": "Bits.OrderManagement.Application.Commands",
    "PrefetchCount": 20,
    "RetryCount": 3,
    "RetryInterval": 5
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "order-management_write_db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
